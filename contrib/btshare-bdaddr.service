# System service for SECONDARY hosts whose adapter must impersonate the
# primary host's Bluetooth address. `btmgmt public-addr` is lost on reboot,
# so this re-applies it before bluetoothd starts.
#   1. Replace 00:11:22:33:44:55 with the primary host's adapter address.
#   2. sudo install -Dm644 contrib/btshare-bdaddr.service /etc/systemd/system/
#   3. sudo systemctl enable btshare-bdaddr
[Unit]
Description=Set Bluetooth adapter address for btshare
After=sys-subsystem-bluetooth-devices-hci0.device
Requires=sys-subsystem-bluetooth-devices-hci0.device
Before=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/bin/btmgmt --index hci0 power off
ExecStart=/usr/bin/btmgmt --index hci0 public-addr 00:11:22:33:44:55

[Install]
WantedBy=bluetooth.target
