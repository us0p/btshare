# Editor settings shared by every contributor (https://editorconfig.org).
# Go files are formatted by gofmt/goimports: run `make fmt`.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.sh]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
